DEBUG=False
SECRET_KEY=GENERATE_WITH_scripts-docker-up.ps1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

POSTGRES_PASSWORD=GENERATE_WITH_scripts-docker-up.ps1
DATABASE_URL=postgres://auction_user:GENERATE_WITH_scripts-docker-up.ps1@db:5432/auction_db
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
BASE_URL=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True


# Optional off-site PostgreSQL backups. Create a private S3 bucket with
# versioning and lifecycle retention, then configure IAM access for this host.
# For local Docker Desktop, set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# only in the private, git-ignored .env.docker file. Never commit those values.
# On AWS compute, prefer an instance/task role instead of long-lived access keys.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=auction-postgres
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys for development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
